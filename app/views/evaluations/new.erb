<h1>New Evaluation</h1>

<div class="card">
  <form method="POST" action="/evaluations">
    <%= csrf_tag %>
    
    <div class="form-group">
      <label for="title">Evaluation Title</label>
      <input type="text" id="title" name="title" required placeholder="e.g., Senior Developer Role Q1 2024">
    </div>
    
    <button type="submit" class="btn btn-primary">Create Evaluation</button>
  </form>
</div>
